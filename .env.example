# Токен бота, который дал тебе @BotFather в Telegram
TELEGRAM_BOT_TOKEN=paste_your_token_here

# Твой часовой пояс, чтобы бот правильно понимал время
TIMEZONE=Europe/Moscow

# (Необязательно) Твой числовой Telegram ID.
# Если заполнить — бот будет слушаться только тебя, а не всех подряд.
# Узнать свой ID можно у бота @userinfobot
ALLOWED_USER_ID=

# (Необязательно) Если api.telegram.org заблокирован для сервера —
# адрес SOCKS5-туннеля до сервера за границей, например:
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080
TELEGRAM_PROXY_URL=
